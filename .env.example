# Copy to .env (gitignored). A blank value keeps the default below.
# A number outside the stated range stops the process at startup.
# uv run and Compose both read this file. Process environment wins
# over .env. Compose passes the file into the agent; the file is
# optional. Leave REDIS_URL unset to use the Compose Redis at
# redis://:devpassword@redis:6379/0. Set REDIS_URL only to point at
# a different Redis. REDIS_PASSWORD changes that Redis password and
# the URL built from it. Inside the container HOST is always
# 0.0.0.0. Loopback hosts of the parser and the model become
# host.docker.internal there. The parser base does not gain /v1.

# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=devpassword
PARSER_BASE_URL=http://127.0.0.1:8080
PARSER_TIMEOUT_SEC=15
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
LLM_MODEL=local
LLM_TIMEOUT_SEC=60
LLM_TEMPERATURE=0
# CLM choice. Chat completions stay on LLM_BASE_URL. Empty key sends no Authorization header.
# Inside the container a loopback host is rewritten to host.docker.internal. The path is kept.
RANKER_BASE_URL=http://127.0.0.1:8700/v1/systemone
RANKER_API_KEY=
RANKER_MODEL=clm-latest
HOST=0.0.0.0
PORT=8090

# Idle checkpoint lifetime in minutes, at least 1. Reading a thread resets it.
CHECKPOINT_TTL_MINUTES=1440
CHECKPOINT_REFRESH_ON_READ=true
# How long a dead run keeps the thread lock, seconds, at least 1.
LOCK_TTL_SEC=900
# LangGraph step cap for one invoke, at least 1.
RECURSION_LIMIT=40

# Content steps before a new gap closes the turn, at least 1.
CONTENT_BUDGET=4
# Clarification replies before the turn closes, at least 1.
CLARIFY_BUDGET=2
# Observations kept for one answer. Integer from 1 to 48.
OBSERVATION_CAP=48
# Catalog hits requested per search phrase. Integer from 1 to 100.
CATALOG_SEARCH_LIMIT=32
# Precedent and dependent graph depth. Integer from 0 to 3.
PRECEDENT_DEPTH=2
# Dependent rows for an influence question. Integer from 1 to 8.
MAX_DEPENDENT_ROWS=4
# Observations requested per dependent row. Integer from 1 to 48.
DEPENDENT_OBSERVATION_LIMIT=8

LANGGRAPH_STRICT_MSGPACK=true
